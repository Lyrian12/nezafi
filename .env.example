# Copier ce fichier en .env (jamais committé, voir .gitignore) et renseigner les vraies valeurs.

# Requis pour les fonctionnalités liées à l'IA.
ANTHROPIC_API_KEY=

# Base de données — facultatif tant qu'on tourne sur H2 en mémoire (valeurs par défaut dans
# application.properties). À définir lors de la bascule PostgreSQL : voir
# docs/postgresql-migration.md pour la création du compte applicatif dédié.
# DB_URL=jdbc:postgresql://localhost:5432/nezafi
# DB_USERNAME=nezafi_app
# DB_PASSWORD=
